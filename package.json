{
  "version": "3.1.0",
  "name": "double-slash-website",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "plop": "plop",
    "sync-durations": "jiti scripts/sync-durations.ts",
    "validate-durations": "jiti scripts/validate-durations.ts",
    "build": "bun run validate-durations && nuxi build",
    "dev": "nuxi dev",
    "start": "node .output/server/index.mjs",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format-check": "prettier --check ./",
    "format-write": "prettier --write ./",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "emit-markdown": "jiti scripts/emit-agent-markdown.ts",
    "generate": "bun run sync-durations && nuxi generate && bun run emit-markdown",
    "clean": "rm -rf .output node_modules bun.lock dist .nuxt"
  },
  "devDependencies": {
    "@browser-echo/nuxt": "^1.1.1",
    "@iconify-json/ant-design": "^1.2.9",
    "@iconify-json/cbi": "^1.2.59",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa6-brands": "^1.2.6",
    "@iconify-json/fluent": "^1.2.58",
    "@iconify-json/ic": "^1.2.4",
    "@iconify-json/iconoir": "^1.2.11",
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/material-symbols": "^1.2.92",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/vscode-icons": "^1.2.79",
    "@nuxt/content": "3.16.0",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/icon": "2.5.1",
    "@nuxt/scripts": "1.3.9",
    "@nuxt/test-utils": "4.3.2",
    "@nuxtjs/color-mode": "4.0.1",
    "@nuxtjs/robots": "6.2.3",
    "@pinia/nuxt": "1.0.2",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/rss": "0.0.32",
    "@types/throttle-debounce": "^5.0.2",
    "@types/xml2json": "0.11.6",
    "baseline-browser-mapping": "^2.11.25",
    "consola": "3.4.2",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "fast-xml-parser": "^5.11.1",
    "jiti": "2.7.0",
    "jsdom": "30.1.0",
    "node-html-markdown": "^2.0.0",
    "nuxt": "4.5.2",
    "nuxt-schema-org": "6.3.2",
    "nuxtseo-layer-devtools": "^5.3.16",
    "pinia": "4.0.3",
    "plop": "4.0.5",
    "postcss-custom-properties": "15.0.1",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "sitemap": "9.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui-templates": "^1.3.4",
    "@sentry/nuxt": "^10.75.0",
    "@tailwindcss/forms": "0.5.11",
    "axios": "1.20.0",
    "motion": "13.4.0",
    "nuxt-llms": "^0.2.0",
    "rss": "1.2.2",
    "simple-json-db": "2.0.0",
    "tailwindcss": "^4.3.3",
    "throttle-debounce": "^5.0.2",
    "vue-lite-youtube-embed": "1.2.4"
  },
  "packageManager": "bun@1.4.2",
  "trustedDependencies": [
    "@parcel/watcher",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "vue-demi"
  ]
}